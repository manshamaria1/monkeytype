# Copy to .env and adjust. Never commit the real .env.
DATABASE_URL=postgresql://monkey:monkey@localhost:5432/monkeytype
# Used only by `npm test` integration tests (database is wiped between runs!)
TEST_DATABASE_URL=postgresql://monkey:monkey@localhost:5432/monkeytype_test
PORT=3000
# NODE_ENV=production is set by `npm start`-style deployments; leave it out for development.
# Public URL of the site, used for links in emails and the Origin check
APP_URL=http://localhost:5173
# Sites allowed to embed the app in an <iframe>, space-separated (e.g. a WordPress site).
# FRAME_ANCESTORS="https://example.com https://www.example.com"
# Optional SMTP for password-reset / verification mail, e.g. smtp://user:pass@smtp.example.com:587
# When unset, emails are written to the server log instead of being sent.
SMTP_URL=
MAIL_FROM="Monkeytype <no-reply@example.com>"
